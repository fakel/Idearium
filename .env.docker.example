# ── Idearium en Docker: SOLO OpenRouter ─────────────────────────────────────
# Copia este archivo a .env y completa los valores.
# No hay Ollama, Whisper local, CUDA ni GPU: chat, embeddings y STT van a
# OpenRouter. La imagen fuerza LLM_PREFERENCE=remote_only y
# EMBEDDING_PROVIDER=openrouter al arrancar.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat. Alternativas free (20 rpm / 50 rpd):
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL=openai/gpt-4o-mini
# OCR de fotos: Gemma 4 31B por defecto; Qwen3-VL 30B como alternativa.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it
OPENROUTER_VISION_FALLBACK_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Embeddings remotos. bge-m3 devuelve 1024 dimensiones; no cambies
# EMBEDDING_DIM si usas otro modelo con otra dimensión.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBED_MODEL=baai/bge-m3
EMBEDDING_DIM=1024

# STT remoto de OpenRouter. El id debe incluir proveedor.
WHISPER_API_URL=https://openrouter.ai/api
WHISPER_MODEL=openai/whisper-large-v3-turbo
WHISPER_TIMEOUT_MS=180000

# Las fotos se guardan antes del OCR.
IMAGES_DIR=/data/images

# Vault y datos: Compose los monta en /vault y /data.
NOTE_SUBDIR=Idearium

RAG_TOP_K=8
MEMORY_MAX_NOTES=5
MEMORY_MAX_CHARS=24000
LLM_TIMEOUT_MS=120000
LOG_LEVEL=info
TZ=America/Lima
