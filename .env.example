# ── Telegram ────────────────────────────────────────────────────────────────
# Create a bot with @BotFather. Without a token the bot stays disabled and the
# CLI still works.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot.
# The bot refuses to start while this is empty.
TELEGRAM_ALLOWED_USER_IDS=

# ── Local AI services (native, no Docker) ───────────────────────────────────
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=8192

# STT local (faster-whisper) o proveedor externo compatible con OpenAI.
# Ejemplos externos:
#   OpenRouter: https://openrouter.ai/api + openai/whisper-large-v3-turbo (misma OPENROUTER_API_KEY)
#   OpenAI:     https://api.openai.com    + whisper-1
#   Groq:       https://api.groq.com/openai + whisper-large-v3
# OpenRouter NO tiene modelos STT gratuitos. Recomendados (pago):
#   openai/whisper-large-v3-turbo  -> el más barato/rápido (~$0.0002/min)
#   openai/gpt-4o-transcribe       -> más precisión con ruido o acentos
#   elevenlabs/scribe-v2           -> multilingüe y diarización
WHISPER_API_URL=http://127.0.0.1:8000
WHISPER_API_KEY=
WHISPER_MODEL=small
WHISPER_TIMEOUT_MS=120000

# ── Obsidian vault ──────────────────────────────────────────────────────────
# Root of your Obsidian vault. Notes are written to <root>/<NOTE_SUBDIR>/.
OBSIDIAN_VAULT_PATH=/home/your-user/Documents/IdeariumVault
NOTE_SUBDIR=Idearium

# ── Local storage ───────────────────────────────────────────────────────────
LANCEDB_PATH=./data/lancedb
AUDIO_DIR=./data/audio
DOCUMENT_DIR=./data/documents
DOCUMENT_MAX_CHARS=200000
EMBEDDING_DIM=1024
# ollama = local (bge-m3); openrouter = remoto.
# Gratis: nvidia/nemotron-3.5-embed-8b:free (32k, consulta su dimensión antes de usarlo).
# Pago recomendado: baai/bge-m3 (1024 dims, $0.01/M tokens, mismo modelo que en local).
EMBEDDING_PROVIDER=ollama
OPENROUTER_EMBED_MODEL=baai/bge-m3

# ── LLM routing (local / remote) ───────────────────────────────────────────
# local_only | local_first | remote_first | remote_only
LLM_PREFERENCE=local_first
# Escalation triggers for local_first: validation_failure, explicit_flag, long_input
LLM_ESCALATE_ON=validation_failure,explicit_flag
LLM_MAX_LOCAL_CHARS=12000
LLM_TIMEOUT_MS=120000

# Solo OpenRouter (no hay DeepSeek). Con OPENROUTER_API_KEY vacía, remote_* degrada a local.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo de chat. Gratis (20 rpm / 50 rpd):
#   google/gemma-4-31b-it:free        -> digest, quiz y clustering en español
#   nvidia/nemotron-3.5-super-vl:free -> RAG con contexto muy largo (1M)
#   dots-studio/dots-3-note-preview:free -> notas/resúmenes (512k)
# Pago:
#   openai/gpt-4o-mini                -> equilibrado y buen JSON (default, $0.15/$0.60 por 1M)
#   deepseek/deepseek-v4-flash        -> DeepSeek vía OpenRouter, el más barato ($0.09/$0.18)
#   google/gemini-3.1-flash-lite      -> RAG largo y barato ($0.25/$1.50)
#   anthropic/claude-sonnet-4.6       -> máxima calidad para /quiz y /cluster ($3/$15)
OPENROUTER_MODEL=
# none | minimal | low | medium | high
# none evita tokens de razonamiento (recomendado para digest/RAG/quiz).
OPENROUTER_REASONING_EFFORT=none

# Alias histórico: si se define, se usa como modelo de OpenRouter.
LLM_REMOTE_MODEL=

# ── RAG ─────────────────────────────────────────────────────────────────────
RAG_TOP_K=8

# Palacio/quiz multi-nota: máximo de notas y caracteres de contexto.
MEMORY_MAX_NOTES=5
MEMORY_MAX_CHARS=24000
LOG_LEVEL=info
